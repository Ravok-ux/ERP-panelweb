rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // Bloquea flags de alto privilegio en documentos de usuario auto-creados
    function sinFlagsPrivilegiados(data) {
      return !data.keys().hasAny(['flags']) || (
        data.flags.get('PUEDE_EDITAR_PRECIO', false)      == false &&
        data.flags.get('PUEDE_CANCELAR_PEDIDO', false)    == false &&
        data.flags.get('PUEDE_VER_CARTERA_GLOBAL', false) == false &&
        data.flags.get('PUEDE_IMPORTAR_CATALOGO', false)  == false &&
        data.flags.get('PUEDE_EXPORTAR_BACKUP', false)    == false &&
        data.flags.get('PUEDE_CONFIG_PROMOCIONES', false) == false &&
        data.flags.get('PUEDE_ORDENES_COMPRA', false)     == false &&
        data.flags.get('PUEDE_CONFIG_COMISIONES', false)  == false &&
        data.flags.get('PUEDE_AUTORIZAR_VISITAS', false)  == false
      );
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function miRol() {
      return perfil().rol;
    }

    function esSuperAdmin() {
      return isAuth() && miRol() == 'SUPER_ADMIN';
    }

    function esAdminOSuperior() {
      return isAuth() && miRol() in ['SUPER_ADMIN', 'GERENTE', 'GERENTE_ZONA', 'ADMINISTRADOR'];
    }

    function esRolConocido() {
      return isAuth() && miRol() in [
        'SUPER_ADMIN', 'GERENTE', 'GERENTE_ZONA',
        'INGENIERO', 'RECUPERADOR', 'ADMINISTRADOR',
        'ALMACENISTA', 'JURIDICO', 'MESA_CONTROL'
      ];
    }

    function cuentaActiva() {
      return isAuth() && perfil().activo == true;
    }

    function tieneFlag(flag) {
      return esSuperAdmin() || (perfil().flags != null && perfil().flags[flag] == true);
    }

    // Valida que un string no esté vacío y no supere un tamaño máximo
    function strValido(val, max) {
      return val is string && val.size() > 0 && val.size() <= max;
    }

    // ── /usuarios ─────────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      // Cada usuario lee su propio perfil; admins leen todos
      allow read: if isAuth() && (request.auth.uid == uid || esAdminOSuperior());

      // Solo SUPER_ADMIN puede crear/editar perfiles de otros
      allow write: if esSuperAdmin();

      // El propio usuario puede actualizar campos de sesión no sensibles
      allow update: if isAuth() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['ultimoAcceso', 'dispositivoId', 'fcmToken']);

      // El propio usuario puede crear su perfil en el primer login.
      // Rol restringido a roles no privilegiados; flags sensibles no pueden ser true.
      allow create: if isAuth() && request.auth.uid == uid
                    && !exists(/databases/$(database)/documents/usuarios/$(uid))
                    && request.resource.data.keys().hasAll(['email','alias','rol','activo'])
                    && request.resource.data.activo == true
                    && request.resource.data.rol in [
                         'INGENIERO','RECUPERADOR','ALMACENISTA','MESA_CONTROL','JURIDICO'
                       ]
                    && sinFlagsPrivilegiados(request.resource.data);
    }

    // ── /ubicaciones ─────────────────────────────────────────────────────────
    match /ubicaciones/{alias} {
      // Cualquier usuario autenticado y activo puede leer todas las ubicaciones (mapa en vivo)
      allow read: if cuentaActiva() && esRolConocido();

      // Solo el propio usuario puede escribir su ubicación
      allow write: if cuentaActiva() && request.auth.uid != null
                   && request.resource.data.alias == alias
                   && strValido(request.resource.data.alias, 60);
    }

    // ── /pedidos ──────────────────────────────────────────────────────────────
    match /pedidos/{pedidoId} {
      // Lectura: todo rol conocido y activo
      allow read: if cuentaActiva() && esRolConocido();

      // Escritura: INGENIERO y RECUPERADOR pueden crear pedidos (su función principal).
      // Admins pueden escribir siempre. El flag permite otorgarlo a otros roles.
      allow write: if cuentaActiva() && (
        esAdminOSuperior() ||
        miRol() in ['INGENIERO', 'RECUPERADOR'] ||
        tieneFlag('PUEDE_CREAR_PEDIDOS')
      );

      // Subcollección items — mismos permisos que el pedido padre
      match /items/{itemId} {
        allow read: if cuentaActiva() && esRolConocido();
        allow write: if cuentaActiva() && (
          esAdminOSuperior() ||
          miRol() in ['INGENIERO', 'RECUPERADOR'] ||
          tieneFlag('PUEDE_CREAR_PEDIDOS')
        );
      }
    }

    // ── /remisiones_credito ───────────────────────────────────────────────────
    match /remisiones_credito/{remisionId} {
      allow read: if cuentaActiva() && esRolConocido();
      // Panel y admins pueden crear o reemplazar el documento completo
      allow write: if cuentaActiva() && (esAdminOSuperior() || tieneFlag('PUEDE_REGISTRAR_REMISION'));
      // APK (INGENIERO/RECUPERADOR) puede actualizar abonos e intereses calculados
      allow update: if cuentaActiva()
                    && miRol() in ['INGENIERO', 'RECUPERADOR']
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly([
                         'abonos',
                         'status','interesGenerado','totalAPagar','xPagarVigente',
                         'masInteresTotal','interesPorDia','diasDeAtraso',
                         'totalAbonado','ultimoRecalculoTs'
                       ]);
    }

    // ── /abonos_remision ─────────────────────────────────────────────────────
    match /abonos_remision/{abonoId} {
      allow read: if cuentaActiva() && esRolConocido();
      allow write: if cuentaActiva() && (esAdminOSuperior() || tieneFlag('PUEDE_REGISTRAR_ABONO'));
    }

    // ── /ordenes_compra ───────────────────────────────────────────────────────
    match /ordenes_compra/{ocId} {
      allow read: if cuentaActiva() && (esAdminOSuperior() || tieneFlag('PUEDE_ORDENES_COMPRA'));
      allow write: if cuentaActiva() && (esAdminOSuperior() || tieneFlag('PUEDE_ORDENES_COMPRA'));
    }

    // ── /comision_config ──────────────────────────────────────────────────────
    match /comision_config/{docId} {
      allow read:  if cuentaActiva() && (esAdminOSuperior() || tieneFlag('PUEDE_VER_COMISIONES'));
      allow write: if cuentaActiva() && (esSuperAdmin() || tieneFlag('PUEDE_CONFIG_COMISIONES'));
    }

    // ── /liquidacion_comision ─────────────────────────────────────────────────
    match /liquidacion_comision/{docId} {
      allow read:  if cuentaActiva() && (esAdminOSuperior() || tieneFlag('PUEDE_VER_COMISIONES'));
      allow write: if cuentaActiva() && esSuperAdmin();
    }

    // ── /log_actividades ──────────────────────────────────────────────────────
    match /log_actividades/{logId} {
      // Lectura: solo admins pueden ver el log global
      allow read: if cuentaActiva() && esAdminOSuperior();

      // Escritura: cualquier usuario autenticado puede registrar su propia actividad
      // Valida que el alias y tipo estén presentes y tengan tamaño razonable
      allow create: if cuentaActiva() && esRolConocido()
                    && strValido(request.resource.data.tipo, 50)
                    && request.resource.data.keys().hasAll(['alias','tipo','timestamp']);

      // No se puede editar ni borrar logs (inmutabilidad de auditoría)
      allow update, delete: if false;
    }

    // ── /comentarios_cliente ──────────────────────────────────────────────────
    match /comentarios_cliente/{comentarioId} {
      // Lectura: MESA_CONTROL, ADMINISTRADOR, GERENTE_ZONA, GERENTE, SUPER_ADMIN
      allow read: if cuentaActiva() && miRol() in [
        'SUPER_ADMIN','GERENTE','GERENTE_ZONA','ADMINISTRADOR','MESA_CONTROL'
      ];

      // Escritura: mismos roles; valida campos y longitudes
      allow create: if cuentaActiva()
                    && miRol() in ['SUPER_ADMIN','GERENTE','GERENTE_ZONA','ADMINISTRADOR','MESA_CONTROL']
                    && request.resource.data.keys().hasAll(['clienteNombre','texto','alias','tipoAccion'])
                    && strValido(request.resource.data.texto, 1000)
                    && strValido(request.resource.data.clienteNombre, 100)
                    && request.resource.data.uid == request.auth.uid;

      // Solo el autor o SUPER_ADMIN puede editar/borrar su propio comentario
      allow update, delete: if cuentaActiva()
                            && (resource.data.uid == request.auth.uid || esSuperAdmin());
    }

    // ── /historial_precios ────────────────────────────────────────────────────
    match /historial_precios/{entradaId} {
      // Lectura: SUPER_ADMIN, GERENTE, ADMINISTRADOR
      allow read: if cuentaActiva() && miRol() in [
        'SUPER_ADMIN','GERENTE','ADMINISTRADOR'
      ];

      // Escritura: APK o web panel con flag PUEDE_EDITAR_PRECIO (o rol SUPER_ADMIN/GERENTE)
      // Los registros son inmutables — no se permite update ni delete
      allow create: if cuentaActiva()
                    && (tieneFlag('PUEDE_EDITAR_PRECIO') || miRol() in ['SUPER_ADMIN','GERENTE'])
                    && request.resource.data.keys().hasAll(['idPretoriano','nombreProducto','precioBase','costoBase','cambiadoPor'])
                    && request.resource.data.precioBase is number
                    && request.resource.data.costoBase is number
                    && strValido(request.resource.data.nombreProducto, 200);

      allow update, delete: if false;
    }

    // ── /productos ────────────────────────────────────────────────────────────
    match /productos/{idPretoriano} {
      // Lectura: cualquier usuario autenticado y activo (APK necesita leer en onSnapshot)
      allow read: if cuentaActiva() && esRolConocido();

      // El APK hace seed inicial con merge — requiere cuenta activa
      // El web panel solo escribe activo/precioBase/costoBase + metadatos
      allow write: if cuentaActiva()
                   && (
                     // SUPER_ADMIN y GERENTE pueden escribir cualquier campo
                     miRol() in ['SUPER_ADMIN', 'GERENTE'] ||
                     // ADMINISTRADOR puede activar/desactivar pero necesita flag para precios
                     (miRol() == 'ADMINISTRADOR'
                       && (
                         // Solo activo: permitido
                         request.resource.data.keys().hasOnly(['activo','modificadoPor','modificadoEn']) ||
                         // Precio/costo: requiere flag
                         tieneFlag('PUEDE_EDITAR_PRECIO')
                       )
                     ) ||
                     // ALMACENISTA puede actualizar stock (ajustes de inventario)
                     (miRol() == 'ALMACENISTA'
                       && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['stock','stockActual','_ts'])
                     ) ||
                     // APK seed: solo merge de campos de catálogo (no precio ni costo)
                     tieneFlag('PUEDE_CREAR_PEDIDOS') // proxy para APK autenticado
                   );
    }

    // ── /historial_precios (web panel también puede escribir) ─────────────────
    // Nota: regla original solo permitía APK via flag. Actualizamos para que
    // el web panel también pueda registrar cambios de precio.

    // ── /configuracion (tickets + control operativo) ──────────────────────────
    match /configuracion/{docId} {
      // Lectura: usuario activo, o usuario nuevo sin doc (primer login del APK)
      allow read: if isAuth() && (
                    cuentaActiva() ||
                    !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
                  );

      // Escritura: solo SUPER_ADMIN o GERENTE pueden modificar la configuración
      allow write: if cuentaActiva()
                   && miRol() in ['SUPER_ADMIN', 'GERENTE']
                   && (
                     // Documento de tickets: campos esperados
                     docId == 'tickets' ||
                     // Documento de control: solo campo funcionalidades + metadatos
                     (docId == 'control'
                       && request.resource.data.keys().hasOnly([
                           'funcionalidades','actualizadoPor','actualizadoEn'])
                     )
                   );
    }

    // ── /geocercas ────────────────────────────────────────────────────────────
    match /geocercas/{geocercaId} {
      // APK necesita leer geocercas al login para validación offline
      allow read: if cuentaActiva() && esRolConocido();

      // Solo SUPER_ADMIN, GERENTE o ADMINISTRADOR pueden crear/editar/borrar geocercas
      allow write: if cuentaActiva()
                   && miRol() in ['SUPER_ADMIN', 'GERENTE', 'ADMINISTRADOR']
                   && strValido(request.resource.data.nombre, 80)
                   && request.resource.data.lat is number
                   && request.resource.data.lng is number
                   && request.resource.data.radioMetros is int;

      allow delete: if cuentaActiva() && miRol() in ['SUPER_ADMIN', 'GERENTE'];
    }

    // ── /visitas ──────────────────────────────────────────────────────────────
    match /visitas/{visitaId} {
      // Lectura: admins y superiores leen todas; el ingeniero lee las propias
      allow read: if cuentaActiva()
                  && (esAdminOSuperior()
                      || resource.data.aliasVendedor == perfil().alias);

      // Creación: cualquier usuario activo puede registrar su propia visita
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.aliasVendedor == perfil().alias
                    && request.resource.data.keys().hasAll(['aliasVendedor','clienteId','timestamp']);

      // Solo admins pueden modificar visitas existentes
      allow update: if cuentaActiva() && esAdminOSuperior();
      allow delete: if false;
    }

    // ── /metas ────────────────────────────────────────────────────────────────
    match /metas/{metaId} {
      // Lectura: admins y el propio ingeniero leen sus metas
      allow read: if cuentaActiva()
                  && (esAdminOSuperior()
                      || resource.data.alias == perfil().alias);

      // Escritura: solo SUPER_ADMIN, GERENTE, ADMINISTRADOR
      allow create, update: if cuentaActiva()
                            && miRol() in ['SUPER_ADMIN', 'GERENTE', 'ADMINISTRADOR']
                            && strValido(request.resource.data.alias, 60)
                            && request.resource.data.metaMonto is number
                            && request.resource.data.fechaInicio is int
                            && request.resource.data.fechaFin is int;

      allow delete: if cuentaActiva() && miRol() in ['SUPER_ADMIN', 'GERENTE'];
    }

    // ── /segmentos ────────────────────────────────────────────────────────────
    match /segmentos/{segmentoId} {
      // APK y web panel necesitan leer la lista de segmentos
      allow read: if cuentaActiva() && esRolConocido();

      // Solo admins pueden crear/editar/borrar segmentos
      allow create, update: if cuentaActiva()
                            && miRol() in ['SUPER_ADMIN', 'GERENTE', 'ADMINISTRADOR']
                            && strValido(request.resource.data.nombre, 60);

      allow delete: if cuentaActiva() && miRol() in ['SUPER_ADMIN', 'GERENTE'];
    }

    // ── /precios_segmento ─────────────────────────────────────────────────────
    match /precios_segmento/{precioId} {
      // APK descarga todos los precios al login; web panel los muestra en la matriz
      allow read: if cuentaActiva() && esRolConocido();

      // Solo admins pueden crear/editar precios de segmento
      allow create, update: if cuentaActiva()
                            && miRol() in ['SUPER_ADMIN', 'GERENTE', 'ADMINISTRADOR']
                            && request.resource.data.segmentoId is string
                            && request.resource.data.idPretoriano is number
                            && request.resource.data.precio is number;

      allow delete: if cuentaActiva() && miRol() in ['SUPER_ADMIN', 'GERENTE'];
    }

    // ── /promociones ──────────────────────────────────────────────────────────
    match /promociones/{promId} {
      // Lectura: admins y todos los roles (para mostrar campañas activas en APK)
      allow read: if cuentaActiva() && esRolConocido();

      // Escritura: SUPER_ADMIN, GERENTE, ADMINISTRADOR
      allow create, update: if cuentaActiva()
                            && miRol() in ['SUPER_ADMIN', 'GERENTE', 'ADMINISTRADOR']
                            && strValido(request.resource.data.nombre, 80)
                            && request.resource.data.puntosXPeso is number
                            && request.resource.data.puntosRecompensa is int
                            && strValido(request.resource.data.fechaInicio, 10)
                            && strValido(request.resource.data.fechaFin, 10);

      allow delete: if cuentaActiva() && miRol() in ['SUPER_ADMIN', 'GERENTE'];
    }

    // ── /puntos_cliente ───────────────────────────────────────────────────────
    match /puntos_cliente/{clienteId} {
      // Lectura: admins y el propio ingeniero responsable del cliente
      allow read: if cuentaActiva() && esAdminOSuperior();

      // Escritura: admins + registro automático desde reglas de negocio del APK
      allow write: if cuentaActiva()
                   && miRol() in ['SUPER_ADMIN', 'GERENTE', 'ADMINISTRADOR']
                   && request.resource.data.puntos is number;
    }

    // ── /historial_puntos ─────────────────────────────────────────────────────
    match /historial_puntos/{entradaId} {
      // Lectura: solo admins pueden ver el historial completo
      allow read: if cuentaActiva() && esAdminOSuperior();

      // Creación: admins pueden registrar ajustes manuales o canjes
      allow create: if cuentaActiva()
                    && miRol() in ['SUPER_ADMIN', 'GERENTE', 'ADMINISTRADOR']
                    && request.resource.data.clienteId is string
                    && request.resource.data.puntos is number
                    && request.resource.data.tipo in ['sumar', 'restar', 'canje'];

      // Los registros de historial son inmutables
      allow update, delete: if false;
    }

    // ── /formularios ──────────────────────────────────────────────────────────
    match /formularios/{formId} {
      // Lectura: todos los roles (el APK descarga plantillas al sincronizar)
      allow read: if cuentaActiva() && esRolConocido();

      // CRUD de plantillas: solo admins
      allow create, update: if cuentaActiva()
                            && miRol() in ['SUPER_ADMIN', 'GERENTE', 'ADMINISTRADOR']
                            && strValido(request.resource.data.nombre, 80);

      allow delete: if cuentaActiva() && miRol() in ['SUPER_ADMIN', 'GERENTE'];
    }

    // ── /respuestas_formulario ────────────────────────────────────────────────
    match /respuestas_formulario/{respId} {
      // Lectura: admins
      allow read: if cuentaActiva() && esAdminOSuperior();

      // El APK crea respuestas — cualquier usuario activo y de rol conocido
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.formularioId is string
                    && request.resource.data.aliasVendedor == perfil().alias
                    && request.resource.data.timestamp is int;

      // Las respuestas son inmutables
      allow update, delete: if false;
    }

    // ── Actualización de autorizaciones en /pedidos ───────────────────────────
    // La regla base de /pedidos ya cubre la lectura. Aquí reforzamos que solo
    // SUPER_ADMIN, GERENTE o ADMINISTRADOR pueden cambiar el status a
    // CONFIRMADO o RECHAZADO (autorización/rechazo de pedidos).
    // Esta regla es complementaria — la regla de /pedidos ya permite write a admins.

    // ── /pedido_items ─────────────────────────────────────────────────────────
    match /pedido_items/{itemId} {
      allow read: if cuentaActiva() && esRolConocido();
      allow write: if cuentaActiva() && (
        esAdminOSuperior() ||
        miRol() in ['INGENIERO', 'RECUPERADOR'] ||
        tieneFlag('PUEDE_CREAR_PEDIDOS')
      );
    }

    // ── /clientes ─────────────────────────────────────────────────────────────
    match /clientes/{clienteId} {
      allow read: if cuentaActiva() && esRolConocido();
      // Escritura: admins + INGENIERO y RECUPERADOR (APK crea/actualiza sus propios clientes)
      allow write: if cuentaActiva()
                   && (esAdminOSuperior()
                       || miRol() in ['INGENIERO', 'RECUPERADOR', 'MESA_CONTROL']
                       || tieneFlag('PUEDE_CREAR_CLIENTES'));
    }

    // ── /clientes/{clienteId}/ubicaciones ────────────────────────────────────
    match /clientes/{clienteId}/ubicaciones/{ubicId} {
      // Lectura: cualquier rol conocido y activo (ingeniero y recuperador deben ver las ubicaciones)
      allow read: if cuentaActiva() && esRolConocido();

      // Creación y edición: INGENIERO, RECUPERADOR, admins
      allow create: if cuentaActiva()
                    && (esAdminOSuperior()
                        || miRol() in ['INGENIERO', 'RECUPERADOR', 'MESA_CONTROL'])
                    && request.resource.data.keys().hasAll(['tipo','lat','lng','creadoPor','creadoEn'])
                    && request.resource.data.lat  is number
                    && request.resource.data.lng  is number
                    && request.resource.data.tipo is string
                    && request.resource.data.tipo.size() > 0
                    && request.resource.data.tipo.size() <= 60;

      allow update: if cuentaActiva()
                    && (esAdminOSuperior()
                        || miRol() in ['INGENIERO', 'RECUPERADOR', 'MESA_CONTROL'])
                    && request.resource.data.lat  is number
                    && request.resource.data.lng  is number;

      // Solo admins pueden eliminar ubicaciones
      allow delete: if cuentaActiva() && esAdminOSuperior();
    }

    // ── /clientes/{clienteId}/ubicaciones/{ubicId}/historial ─────────────────
    match /clientes/{clienteId}/ubicaciones/{ubicId}/historial/{logId} {
      allow read:   if cuentaActiva() && esRolConocido();
      // Solo creación — el historial es inmutable una vez escrito
      allow create: if cuentaActiva()
                    && (esAdminOSuperior()
                        || miRol() in ['INGENIERO', 'RECUPERADOR', 'MESA_CONTROL'])
                    && request.resource.data.keys().hasAll(['quien','rol','cuándo'])
                    && request.resource.data.quien is string;
      allow update, delete: if false;
    }

    // ── /clientes/{clienteId}/visitas_log ────────────────────────────────────
    match /clientes/{clienteId}/visitas_log/{logId} {
      allow read: if cuentaActiva() && esRolConocido();
      allow create: if cuentaActiva()
                   && (esAdminOSuperior()
                       || miRol() in ['INGENIERO', 'RECUPERADOR', 'MESA_CONTROL', 'VENDEDOR']);
      allow update, delete: if false;
    }

    // ── /solicitudes_visita ───────────────────────────────────────────────────
    match /solicitudes_visita/{solId} {
      // Lectura: admins, gerentes y mesa de control
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'MESA_CONTROL' || tieneFlag('PUEDE_AUTORIZAR_VISITAS'));

      // El ingeniero puede crear su propia solicitud
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.keys().hasAll(['clienteId','clienteNombre','solicitadoPor','status','creadaEn'])
                    && request.resource.data.status == 'PENDIENTE'
                    && request.resource.data.solicitadoPor == perfil().alias;

      // Solo quien puede autorizar puede cambiar el status
      allow update: if cuentaActiva()
                    && (esAdminOSuperior() || miRol() == 'MESA_CONTROL' || tieneFlag('PUEDE_AUTORIZAR_VISITAS'))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resueltaPor','resueltaEn']);

      allow delete: if false;
    }

    // ── /movimientos_stock (kardex) ───────────────────────────────────────────
    match /movimientos_stock/{movId} {
      // Lectura: admins y ALMACENISTA
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'ALMACENISTA');

      // Dos rutas de escritura (OR):
      // 1. Panel web / ALMACENISTA — ajustes manuales con campos _ts
      // 2. APK (INGENIERO/RECUPERADOR) — ventas, cargas, descargas; campo timestamp + _origen=apk
      allow create: if cuentaActiva()
                    && (
                      // Panel / almacenista
                      ((esAdminOSuperior() || miRol() == 'ALMACENISTA')
                        && request.resource.data.keys().hasAll(['productoId','tipo','cantidad','_ts'])
                        && request.resource.data.tipo in [
                            'ENTRADA','SALIDA','AJUSTE','DEVOLUCION','TRASLADO',
                            'AJUSTE_ENTRADA','AJUSTE_SALIDA','AJUSTE_INVENTARIO','EDITAR_MINIMO',
                            'REABASTO_SURTIDO'
                        ]
                        && request.resource.data.cantidad is number)
                      ||
                      // APK (ingeniero / recuperador / almacenista en campo)
                      (miRol() in ['INGENIERO','RECUPERADOR','ALMACENISTA']
                        && request.resource.data.keys().hasAll(['productoId','tipo','cantidad','timestamp'])
                        && request.resource.data.tipo in [
                            'VENTA','CARGA','DESCARGA','TRANSFERENCIA',
                            'AJUSTE_ENTRADA','AJUSTE_SALIDA','DEVOLUCION'
                        ]
                        && request.resource.data.cantidad is number
                        && request.resource.data.get('_origen','') == 'apk')
                    );

      // Los movimientos son inmutables (auditoría)
      allow update, delete: if false;
    }

    // ── /alertas_stock ────────────────────────────────────────────────────────
    match /alertas_stock/{alertaId} {
      // Lectura: admins y ALMACENISTA
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'ALMACENISTA');

      // Creación: Cloud Functions (Admin SDK, ignora reglas) + admins para alertas manuales
      allow create: if cuentaActiva() && esAdminOSuperior()
                    && request.resource.data.keys().hasAll(['productoId','stockActual','stockMinimo','resuelta'])
                    && request.resource.data.resuelta == false;

      // Solo admins pueden marcar alertas como resueltas
      allow update: if cuentaActiva()
                    && (esAdminOSuperior() || miRol() == 'ALMACENISTA')
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resuelta','resueltaEn','resueltaPor']);

      allow delete: if false;
    }

    // ── /stock_ingenieros ─────────────────────────────────────────────────────
    // Inventario asignado a cada ingeniero en su vehículo
    match /stock_ingenieros/{uid} {
      // Lectura: el propio ingeniero o admins/almacenista
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'ALMACENISTA'
                      || request.auth.uid == uid);
      // Escritura: admins y almacenistas (actualizan al surtir); Cloud Functions actualiza vía Admin SDK
      allow write: if cuentaActiva()
                   && (esAdminOSuperior() || miRol() == 'ALMACENISTA');
    }

    // ── /conteos_fisicos ──────────────────────────────────────────────────────
    // Conteos físicos cíclicos del inventario del panel web
    match /conteos_fisicos/{conteoId} {
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'ALMACENISTA');
      allow create: if cuentaActiva()
                    && (esAdminOSuperior() || miRol() == 'ALMACENISTA');
      allow update: if cuentaActiva()
                    && (esAdminOSuperior() || miRol() == 'ALMACENISTA');
      allow delete: if cuentaActiva() && esAdminOSuperior();
    }

    // ── /solicitudes_reabasto ─────────────────────────────────────────────────
    // Solicitudes de reabasto enviadas desde el APK
    match /solicitudes_reabasto/{solId} {
      // Queries (list): admins y almacenistas; los ingenieros ven sus solicitudes via query filtrada
      allow list: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'ALMACENISTA'
                      || miRol() in ['INGENIERO','RECUPERADOR']);
      // Lectura individual (get): admins, almacenistas o el propio ingeniero
      allow get: if cuentaActiva()
                 && (esAdminOSuperior() || miRol() == 'ALMACENISTA'
                     || resource.data.ingenieroUid == request.auth.uid);
      // Creación: cualquier rol activo (APK lo crea desde el ingeniero)
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.keys().hasAll(['ingenieroUid','ingenieroAlias','estado','items','_ts']);
      // Actualización: admins y almacenistas (cambios de estado)
      allow update: if cuentaActiva()
                    && (esAdminOSuperior() || miRol() == 'ALMACENISTA'
                        // El ingeniero solo puede marcar como recibido
                        || (resource.data.ingenieroUid == request.auth.uid
                            && resource.data.estado == 'SURTIDO'
                            && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['estado','tsRecibido','notasIngeniero'])));
      allow delete: if false;
    }

    // ── /estadisticas_zona ────────────────────────────────────────────────────
    // Estadísticas de ventas y demanda por zona geográfica
    match /estadisticas_zona/{zona} {
      allow read: if cuentaActiva() && esRolConocido();
      allow write: if cuentaActiva() && esAdminOSuperior();
    }

    // ── /cotizaciones ─────────────────────────────────────────────────────────
    match /cotizaciones/{cotId} {
      // Lectura: admins, gerentes, mesa de control + ingeniero propietario
      allow read: if cuentaActiva()
                  && (esAdminOSuperior()
                      || miRol() in ['MESA_CONTROL', 'RECUPERADOR']
                      || (miRol() == 'INGENIERO' && resource.data.ingenieroAlias == perfil().alias));

      // Crear: cualquier rol activo (ingeniero crea sus cotizaciones)
      allow create: if cuentaActiva()
                    && esRolConocido()
                    && request.resource.data.keys().hasAll(['folio','clienteId','status','ingenieroAlias'])
                    && request.resource.data.status == 'BORRADOR';

      // Actualizar: propietario puede cambiar estado, admins todo
      allow update: if cuentaActiva()
                    && (esAdminOSuperior()
                        || (miRol() == 'INGENIERO'
                            && resource.data.ingenieroAlias == perfil().alias
                            && request.resource.data.status in ['BORRADOR','ENVIADA','EXPIRADA']));

      allow delete: if false;
    }

    // ── /campanas_promociones ─────────────────────────────────────────────────
    match /campanas_promociones/{promoId} {
      // Lectura: cualquier usuario autenticado (APK necesita leer las promos activas)
      allow read: if isAuth();

      // Escritura: solo SUPER_ADMIN, ADMINISTRADOR o flag PUEDE_CONFIG_PROMOCIONES
      allow create, update: if cuentaActiva()
                             && (esAdminOSuperior()
                                 || (perfil().keys().hasAny(['flags'])
                                     && 'PUEDE_CONFIG_PROMOCIONES' in perfil().flags));

      allow delete: if esSuperAdmin();
    }

    // ── /configuracion/cotizaciones ───────────────────────────────────────────
    match /configuracion/cotizaciones {
      allow read: if isAuth();
      allow write: if cuentaActiva() && esAdminOSuperior();
    }

    // ── /notificaciones_web ───────────────────────────────────────────────────
    match /notificaciones_web/{notifId} {
      // Leer solo las propias (destinatario incluye el uid o "TODOS")
      allow read: if isAuth() && (
        request.auth.uid in resource.data.destinatarios ||
        'TODOS' in resource.data.destinatarios
      );
      // Crear: solo Cloud Functions (vía Admin SDK, sin auth token) o admin
      allow create: if cuentaActiva() && esAdminOSuperior();
      // Actualizar: solo marcar como leída (solo el campo 'leida')
      allow update: if isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow delete: if esSuperAdmin();
    }

    // ── /devoluciones ─────────────────────────────────────────────────────────
    match /devoluciones/{devId} {
      // Lectura: admin o el propio ingeniero que la creó
      allow read: if cuentaActiva() && (
        esAdminOSuperior() ||
        ['MESA_CONTROL','GERENTE_ZONA'].hasAny([miRol()]) ||
        resource.data.ingenieroUid == request.auth.uid
      );
      // Crear: cualquier usuario autenticado activo
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.status == 'PENDIENTE';
      // Actualizar: aprobar/rechazar solo admins; el ingeniero no puede cambiar status
      allow update: if cuentaActiva() && (
        esAdminOSuperior() ||
        ['MESA_CONTROL'].hasAny([miRol()])
      );
      allow delete: if esSuperAdmin();
    }

    // ── /notas_credito ────────────────────────────────────────────────────────
    match /notas_credito/{ncId} {
      allow read: if cuentaActiva() && esAdminOSuperior();
      allow create, update: if false; // Solo Cloud Functions vía Admin SDK
      allow delete: if esSuperAdmin();
    }

    // ── /mensajes_internos ────────────────────────────────────────────────────
    match /mensajes_internos/{msgId} {
      allow read: if cuentaActiva();
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.uid == request.auth.uid;
      // Reacciones: cualquier usuario activo puede agregar/quitar reacciones
      // Pin: solo admins pueden fijar/desfijar mensajes
      allow update: if cuentaActiva() && (
        // Reacciones: solo se modifican campos reacciones.*
        (esRolConocido() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacciones'])) ||
        // Pin/unpin: solo admins
        (esAdminOSuperior() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pinned','pinnedBy','pinnedAt']))
      );
      allow delete: if esSuperAdmin();
    }

    // ── /canales_chat ─────────────────────────────────────────────────────────
    match /canales_chat/{canalId} {
      allow read: if cuentaActiva() && esRolConocido();
      allow create, update: if cuentaActiva() && esAdminOSuperior()
                            && request.resource.data.nombre is string
                            && request.resource.data.nombre.size() > 0;
      allow delete: if cuentaActiva() && esAdminOSuperior();
    }

    // ── /typing_indicators ────────────────────────────────────────────────────
    match /typing_indicators/{canalId} {
      allow read: if cuentaActiva() && esRolConocido();
      allow write: if cuentaActiva() && esRolConocido();
    }

    // ── /configuracion/alertas_cobranza ───────────────────────────────────────
    match /configuracion/alertas_cobranza {
      allow read: if cuentaActiva() && esAdminOSuperior();
      allow write: if cuentaActiva() && esAdminOSuperior();
    }

    // ── /rh_asistencia ────────────────────────────────────────────────────────
    match /rh_asistencia/{docId} {
      // Admins ven todo; cada empleado solo lee sus propios registros (módulo Mi RH)
      allow read:   if cuentaActiva() && (
                      esAdminOSuperior() || miRol() == 'MESA_CONTROL' ||
                      (esRolConocido() && resource.data.uid == request.auth.uid)
                    );
      allow create: if cuentaActiva() && (esAdminOSuperior() || miRol() == 'MESA_CONTROL');
      allow update: if cuentaActiva() && esAdminOSuperior();
      allow delete: if esSuperAdmin();
    }

    // ── /rh_vacaciones ────────────────────────────────────────────────────────
    match /rh_vacaciones/{docId} {
      allow read:   if cuentaActiva() && (
                      esAdminOSuperior() || miRol() == 'MESA_CONTROL' ||
                      (esRolConocido() && resource.data.uid == request.auth.uid)
                    );
      // El empleado puede crear su propia solicitud; solo puede iniciarla como PENDIENTE
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'PENDIENTE'
                    && request.resource.data.keys().hasAll(['uid','desde','hasta','status','solicitadaEn']);
      allow update: if cuentaActiva() && (esAdminOSuperior() || miRol() == 'GERENTE_ZONA');
      allow delete: if esSuperAdmin();
    }

    // ── /rh_anticipos ────────────────────────────────────────────────────────
    match /rh_anticipos/{docId} {
      allow read:   if cuentaActiva() && (
                      esAdminOSuperior() || miRol() == 'MESA_CONTROL' ||
                      (esRolConocido() && resource.data.uid == request.auth.uid)
                    );
      // El empleado puede solicitar un anticipo propio; monto mínimo 100
      // Los admins pueden crear adeudos de inventario (tipo ADEUDO_INVENTARIO)
      allow create: if cuentaActiva() && (
        (esRolConocido()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.monto is number
          && request.resource.data.monto >= 100
          && strValido(request.resource.data.motivo, 500)
          && request.resource.data.status == 'PENDIENTE')
        || (esAdminOSuperior()
          && request.resource.data.tipo == 'ADEUDO_INVENTARIO'
          && request.resource.data.status == 'ADEUDO')
      );
      allow update: if cuentaActiva() && esAdminOSuperior();
      allow delete: if esSuperAdmin();
    }

    // ── /audit_log ────────────────────────────────────────────────────────────
    // Solo lectura para admin; escritura solo desde Admin SDK (Cloud Functions)
    match /audit_log/{docId} {
      allow read:   if cuentaActiva() && esAdminOSuperior();
      allow create: if false; // Solo Cloud Functions
      allow update, delete: if false; // Inmutable — trazabilidad de auditoría
    }

    // ── /inventario ───────────────────────────────────────────────────────────
    match /inventario/{docId} {
      allow read:   if cuentaActiva() && esRolConocido();
      allow write:  if cuentaActiva() && esAdminOSuperior();
    }

    // ── /prospectos ───────────────────────────────────────────────────────────
    match /prospectos/{docId} {
      allow read:   if cuentaActiva() && esRolConocido();
      allow create: if cuentaActiva() && esRolConocido();
      // Solo admin o el creador del prospecto puede modificarlo
      allow update: if cuentaActiva() && (
                      esAdminOSuperior() ||
                      resource.data.creadoPor == perfil().alias
                    );
      allow delete: if esSuperAdmin();
    }

    // ── /visitas_programadas ──────────────────────────────────────────────────
    match /visitas_programadas/{docId} {
      allow read:   if cuentaActiva() && esRolConocido();
      allow create: if cuentaActiva() && esAdminOSuperior();
      allow update: if cuentaActiva() && esRolConocido();
      allow delete: if esSuperAdmin();
    }

    // ── /rh_pagos_nomina ──────────────────────────────────────────────────────
    match /rh_pagos_nomina/{docId} {
      allow read:   if cuentaActiva() && esAdminOSuperior();
      allow create: if cuentaActiva() && esAdminOSuperior();
      allow update, delete: if esSuperAdmin();
    }

    // ── /rh_nomina ────────────────────────────────────────────────────────────
    match /rh_nomina/{docId} {
      // Admins ven todos; empleado solo sus propios recibos (módulo Mi RH)
      allow read:   if cuentaActiva() && (
                      esAdminOSuperior() || miRol() == 'MESA_CONTROL' ||
                      (esRolConocido() && resource.data.uid == request.auth.uid)
                    );
      allow create, update: if cuentaActiva() && esAdminOSuperior();
      allow delete:         if esSuperAdmin();
    }

    // ── /juridico_notas ───────────────────────────────────────────────────────
    match /juridico_notas/{notaId} {
      // Solo roles con acceso al módulo Jurídico
      allow read: if cuentaActiva()
                  && miRol() in ['SUPER_ADMIN','GERENTE','GERENTE_ZONA','ADMINISTRADOR','JURIDICO','RECUPERADOR'];

      allow create: if cuentaActiva()
                    && miRol() in ['SUPER_ADMIN','GERENTE','GERENTE_ZONA','ADMINISTRADOR','JURIDICO','RECUPERADOR']
                    && request.resource.data.keys().hasAll(['clienteId','clienteNombre','tipo','texto','autor','creadaEn'])
                    && request.resource.data.tipo in ['NOTA','PROMESA']
                    && strValido(request.resource.data.texto, 1000)
                    && request.resource.data.autor == perfil().alias;

      // Solo admins pueden editar o borrar notas existentes
      allow update, delete: if cuentaActiva()
                            && miRol() in ['SUPER_ADMIN','GERENTE','ADMINISTRADOR'];
    }

    // ── /metricas_diarias ─────────────────────────────────────────────────────
    match /metricas_diarias/{docId} {
      // Solo admins y gerentes pueden ver las métricas del sistema
      allow read:  if cuentaActiva() && esAdminOSuperior();
      allow write: if false; // Escritura exclusiva de Cloud Functions (Admin SDK)
    }

    // ── /backups_manifesto ────────────────────────────────────────────────────
    match /backups_manifesto/{docId} {
      allow read:  if cuentaActiva() && esAdminOSuperior();
      allow write: if false; // Escritura exclusiva de Cloud Functions (Admin SDK)
    }

    // ── /geofence_eventos ─────────────────────────────────────────────────────
    match /geofence_eventos/{docId} {
      // Admins y mesa de control ven todos los eventos
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'MESA_CONTROL');

      // El APK escribe eventos de transición; tipo restringido a los válidos
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.keys().hasAll(['tipo','geocercaId','alias','timestamp'])
                    && request.resource.data.tipo in ['ENTRADA','SALIDA','PERMANENCIA']
                    && request.resource.data.alias == perfil().alias;

      allow update, delete: if false; // Inmutable — auditoría de presencia
    }

    // ── /notificaciones_web (complemento APK geocerca) ────────────────────────
    // La regla base de /notificaciones_web permite create solo a admins desde web.
    // El APK necesita crear notificaciones de geocerca como usuario autenticado.
    // Se extiende aquí con un match más específico por tipo de notificación.
    // (Firestore aplica la regla más permisiva entre matches que se superponen)
    match /notificaciones_web/{notifId} {
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.tipo in ['GEOCERCA_ENTRADA','GEOCERCA_SALIDA']
                    && request.resource.data.keys().hasAll(['tipo','destinatarios','titulo','_ts']);
    }

    // ── /gastos_empleado ──────────────────────────────────────────────────────
    match /gastos_empleado/{docId} {
      // El propio empleado puede ver sus gastos; admins y mesa_control ven todos
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'MESA_CONTROL'
                      || request.auth.uid == resource.data.uid);

      // El empleado crea su propio gasto; campos mínimos requeridos
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid','alias','categoria','monto','descripcion','status','_ts'])
                    && request.resource.data.status == 'PENDIENTE'
                    && request.resource.data.monto is number
                    && request.resource.data.monto > 0
                    && request.resource.data.monto <= 50000
                    && strValido(request.resource.data.descripcion, 500)
                    && request.resource.data.categoria in ['GASOLINA','ALIMENTACION','HOSPEDAJE','TRANSPORTE','COMUNICACION','OTRO'];

      // Solo admins y mesa_control pueden cambiar el status (aprobar/rechazar)
      allow update: if cuentaActiva()
                    && (esAdminOSuperior() || miRol() == 'MESA_CONTROL')
                    && request.resource.data.uid == resource.data.uid // uid inmutable
                    && request.resource.data.status in ['APROBADO','RECHAZADO'];

      allow delete: if false;
    }

    // ── /cortes_caja ──────────────────────────────────────────────────────────
    match /cortes_caja/{docId} {
      // Admins y el propio empleado pueden leer sus cortes
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'MESA_CONTROL'
                      || request.auth.uid == resource.data.uid);

      // El empleado crea su propio corte
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid','alias','turno','efectivo','tarjeta','transferencia','status','_ts'])
                    && request.resource.data.status == 'PENDIENTE'
                    && request.resource.data.turno in ['MAÑANA','TARDE','NOCHE']
                    && request.resource.data.efectivo    is number
                    && request.resource.data.tarjeta     is number
                    && request.resource.data.transferencia is number;

      // Solo admins y mesa_control pueden validar/marcar diferencia
      allow update: if cuentaActiva()
                    && (esAdminOSuperior() || miRol() == 'MESA_CONTROL')
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.status in ['VALIDADO','DIFERENCIA'];

      allow delete: if false;
    }

    // ── /asistencias ──────────────────────────────────────────────────────────
    match /asistencias/{docId} {
      // Admins y mesa_control leen todas; el empleado lee las propias
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'MESA_CONTROL'
                      || request.auth.uid == resource.data.uid);

      // El empleado crea/actualiza su propio registro de asistencia (check-in/out)
      allow create: if cuentaActiva() && esRolConocido()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid','alias','fecha','checkInTs','_ts']);

      allow update: if cuentaActiva() && esRolConocido()
                    && request.auth.uid == resource.data.uid
                    && request.resource.data.uid == resource.data.uid; // uid inmutable

      allow delete: if false;
    }

    // ── /sms_campanas ─────────────────────────────────────────────────────────
    match /sms_campanas/{docId} {
      // Solo admins y mesa_control leen el historial
      allow read: if cuentaActiva() && (esAdminOSuperior() || miRol() == 'MESA_CONTROL');

      // Solo admins crean campañas
      allow create: if cuentaActiva() && esAdminOSuperior()
                    && request.resource.data.keys().hasAll(['segmento','mensaje','status','_ts'])
                    && request.resource.data.status == 'PENDIENTE'
                    && request.resource.data.segmento in ['todos','deudores','sin_compra_30','manual']
                    && strValido(request.resource.data.mensaje, 160);

      // Cloud Functions actualizan el status (Admin SDK, bypasses rules)
      allow update, delete: if false;
    }

    // ── /lealtad_config_producto ──────────────────────────────────────────────
    match /lealtad_config_producto/{docId} {
      allow read: if cuentaActiva() && esRolConocido();
      allow write: if cuentaActiva() && (esAdminOSuperior() || tieneFlag('PUEDE_CONFIG_PROMOCIONES'));
    }

    // ── /horarios_empleado ────────────────────────────────────────────────────
    match /horarios_empleado/{alias} {
      // El empleado ve su propio horario; admins y mesa_control ven todos
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'MESA_CONTROL'
                      || perfil().alias == alias);

      // Solo admins y mesa_control configuran horarios
      allow write: if cuentaActiva() && (esAdminOSuperior() || miRol() == 'MESA_CONTROL')
                   && request.resource.data.keys().hasAll(['alias','horaEntrada','horaSalida','toleranciaMin'])
                   && request.resource.data.toleranciaMin is int
                   && request.resource.data.toleranciaMin >= 0
                   && request.resource.data.toleranciaMin <= 120;
    }

    // ── /historial_tipo_cambio ────────────────────────────────────────────────
    match /historial_tipo_cambio/{docId} {
      allow read: if cuentaActiva() && esRolConocido();
      // Solo Cloud Functions escriben en el historial (Admin SDK)
      allow write: if false;
    }

    // ── /config ───────────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read: if cuentaActiva() && esRolConocido();
      // Solo admins y gerentes actualizan tipo de cambio u otras configuraciones globales
      allow write: if cuentaActiva() && esAdminOSuperior();
    }

    // ── /manuales ─────────────────────────────────────────────────────────────
    match /manuales/{docId} {
      // Cualquier usuario autenticado y activo puede consultar manuales
      allow read: if cuentaActiva() && esRolConocido();
      // Solo admins pueden crear, editar o eliminar
      allow write: if cuentaActiva() && esAdminOSuperior()
                   && request.resource.data.titulo is string
                   && request.resource.data.titulo.size() > 0
                   && request.resource.data.categoria in ['flujo','politica','proceso','formato','otro']
                   && request.resource.data.tipo in ['texto','mermaid'];
    }

    // ── /comisiones_n10 ───────────────────────────────────────────────────────
    match /comisiones_n10/{docId} {
      // Lectura: admins y el propio ingeniero (su uid está en el docId)
      allow read: if cuentaActiva()
                  && (esAdminOSuperior()
                      || request.auth.uid == resource.data.uid
                      || tieneFlag('PUEDE_VER_COMISIONES'));
      // Escritura: solo via motor de comisiones (admins o el propio ingeniero con flag)
      allow write: if cuentaActiva()
                   && (esAdminOSuperior() || tieneFlag('PUEDE_VER_COMISIONES'));
    }

    // ── /config_catalogo ──────────────────────────────────────────────────────
    match /config_catalogo/{docId} {
      // Cualquier usuario activo puede leer el catálogo de marcas/categorías
      allow read: if cuentaActiva() && esRolConocido();
      // Solo GERENTE/ADMIN pueden modificar el catálogo
      allow write: if cuentaActiva()
                   && miRol() in ['SUPER_ADMIN', 'GERENTE', 'ADMINISTRADOR'];
    }

    // ── /config_intereses ────────────────────────────────────────────────────
    // Lectura: cualquier rol conocido (los módulos la consultan para obtener la tasa)
    // Escritura: solo SUPER_ADMIN (tasa global e historial de cambios)
    match /config_intereses/{docId} {
      allow read: if cuentaActiva() && esRolConocido();
      allow write: if cuentaActiva() && esSuperAdmin();
    }

    // ── /traspasos ────────────────────────────────────────────────────────────
    match /traspasos/{traspasoId} {
      // Lectura: admins, gerentes, mesa de control y quien tenga flag PUEDE_CREAR_CLIENTES
      allow read: if cuentaActiva()
                  && (esAdminOSuperior()
                      || miRol() == 'MESA_CONTROL'
                      || tieneFlag('PUEDE_CREAR_CLIENTES'));

      // Creación: mismos roles (registro de auditoría de reasignación de clientes)
      allow create: if cuentaActiva()
                    && (esAdminOSuperior()
                        || miRol() == 'MESA_CONTROL'
                        || tieneFlag('PUEDE_CREAR_CLIENTES'))
                    && request.resource.data.keys().hasAll(['ingenieroOrigen','ingenieroDestino','clienteIds','fecha'])
                    && request.resource.data.clienteIds is list;

      // Los traspasos son inmutables (auditoría)
      allow update, delete: if false;
    }

    // ── /calendario_agricola ─────────────────────────────────────────────────
    match /calendario_agricola/{docId} {
      allow read:             if cuentaActiva() && esRolConocido();
      allow create, update:   if cuentaActiva() && esAdminOSuperior();
      allow delete:           if cuentaActiva() && esAdminOSuperior();
    }

    // ── /recetas_agroquimicas ─────────────────────────────────────────────────
    match /recetas_agroquimicas/{docId} {
      allow read:             if cuentaActiva() && esRolConocido();
      allow create, update:   if cuentaActiva() && esAdminOSuperior();
      allow delete:           if cuentaActiva() && esAdminOSuperior();
    }

    // ── /trazabilidad_campo ───────────────────────────────────────────────────
    match /trazabilidad_campo/{docId} {
      allow read:   if cuentaActiva() && esRolConocido();
      allow create: if cuentaActiva() && esRolConocido();
      allow update, delete: if cuentaActiva() && esAdminOSuperior();
    }

    // ── /proveedores ──────────────────────────────────────────────────────────
    match /proveedores/{docId} {
      allow read:           if cuentaActiva() && esRolConocido();
      allow create, update: if cuentaActiva() && esAdminOSuperior();
      allow delete:         if cuentaActiva() && esAdminOSuperior();
    }

    // ── /comision_cobranza_config ─────────────────────────────────────────────
    match /comision_cobranza_config/{docId} {
      allow read:           if cuentaActiva() && esRolConocido();
      allow create, update: if cuentaActiva() && esAdminOSuperior();
      allow delete:         if cuentaActiva() && esAdminOSuperior();
    }

    // ── /blacklist ────────────────────────────────────────────────────────────
    // Lectura: cualquier rol autenticado
    // Escritura (crear/editar): GERENTE, ADMINISTRADOR, SUPER_ADMIN
    // Actualización parcial (solicitar rehab): cualquier rol autenticado
    match /blacklist/{docId} {
      allow read: if esRolConocido();
      allow create: if esAdminOSuperior();
      allow update: if esAdminOSuperior()
        || (esRolConocido()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['rehabSolicitud','historial']));
      allow delete: if esSuperAdmin();
    }

    // ── /rutas (historial GPS de ruta del ingeniero por día) ─────────────────
    // Estructura: rutas/{alias}/dias/{fecha}/puntos/{timestamp}
    // El APK escribe un punto por cada ping GPS durante la jornada (enJornada=true).
    // El panel web puede leer para mostrar la ruta recorrida del día.
    match /rutas/{alias} {
      allow read: if cuentaActiva() && (esAdminOSuperior() || perfil().alias == alias);

      match /dias/{dia}/puntos/{puntoId} {
        allow read: if cuentaActiva() && (esAdminOSuperior() || perfil().alias == alias);
        // Solo el propio ingeniero puede escribir sus puntos de ruta
        allow create: if cuentaActiva() && esRolConocido()
                      && perfil().alias == alias
                      && request.resource.data.lat is number
                      && request.resource.data.lng is number
                      && request.resource.data.ts  is number;
        allow update, delete: if false;
      }
    }

    // ── /remisiones (copia standalone del APK, distinta de remisiones_credito) ─
    // El APK escribe aquí para que el panel pueda leer remisiones sin esperar sync.
    match /remisiones/{remisionId} {
      allow read: if cuentaActiva() && esRolConocido();
      allow create, update: if cuentaActiva() && (
        esAdminOSuperior() ||
        miRol() in ['INGENIERO', 'RECUPERADOR'] ||
        tieneFlag('PUEDE_REGISTRAR_REMISION')
      );
      allow delete: if false;
    }

    // ── /abonos (copia standalone del APK, distinta de abonos_remision) ────────
    // El APK escribe abonos aquí (además de embebidos en remisiones_credito).
    match /abonos/{abonoId} {
      allow read: if cuentaActiva() && esRolConocido();
      allow create, update: if cuentaActiva() && (
        esAdminOSuperior() ||
        miRol() in ['INGENIERO', 'RECUPERADOR'] ||
        tieneFlag('PUEDE_REGISTRAR_ABONO')
      );
      allow delete: if false;
    }

    // ── Bloqueo por defecto ───────────────────────────────────────────────────
    // Cualquier colección no listada queda denegada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
