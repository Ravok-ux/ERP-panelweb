rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function miRol() {
      return perfil().rol;
    }

    function esAdminOSuperior() {
      return isAuth() && miRol() in ['SUPER_ADMIN', 'GERENTE', 'GERENTE_ZONA', 'ADMINISTRADOR'];
    }

    function esRolConocido() {
      return isAuth() && miRol() in [
        'SUPER_ADMIN', 'GERENTE', 'GERENTE_ZONA',
        'INGENIERO', 'RECUPERADOR', 'ADMINISTRADOR',
        'ALMACENISTA', 'JURIDICO', 'MESA_CONTROL'
      ];
    }

    function cuentaActiva() {
      return isAuth() && perfil().activo == true;
    }

    // ── evidencias/{alias}/{fecha}/{visitaId}.jpg ──────────────────────────────
    // El APK sube las fotos de evidencia de visita bajo la ruta del propio ingeniero.
    // El web panel las lee para mostrar en el historial de visitas.
    match /evidencias/{alias}/{fecha}/{archivo} {
      // Lectura: admins o el propio ingeniero
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || perfil().alias == alias);

      // Escritura (subida): solo el APK del ingeniero — verifica alias coincide
      allow write: if cuentaActiva()
                   && esRolConocido()
                   && perfil().alias == alias
                   // Solo imágenes JPEG/PNG (MIME type)
                   && request.resource.contentType.matches('image/(jpeg|png)')
                   // Máximo 10 MB por foto
                   && request.resource.size <= 10 * 1024 * 1024;

      // El APK y el worker de cleanup pueden borrar fotos propias
      // Los admins pueden borrar cualquier foto (ej. contenido inapropiado)
      allow delete: if cuentaActiva()
                    && (esAdminOSuperior() || perfil().alias == alias);
    }

    // ── formularios_fotos/{alias}/{formularioId}/{archivo} ────────────────────
    match /formularios_fotos/{alias}/{formularioId}/{archivo} {
      allow read: if cuentaActiva() && (esAdminOSuperior() || perfil().alias == alias);
      allow write: if cuentaActiva()
                   && esRolConocido()
                   && perfil().alias == alias
                   && request.resource.contentType.matches('image/(jpeg|png)')
                   && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if cuentaActiva() && (esAdminOSuperior() || perfil().alias == alias);
    }

    // ── gastos/{uid}/{archivo} ────────────────────────────────────────────────
    // El APK del empleado sube la foto del ticket de gasto bajo su propio UID.
    match /gastos/{uid}/{archivo} {
      // Lectura: el propio empleado o admins/mesa_control
      allow read: if cuentaActiva()
                  && (esAdminOSuperior() || miRol() == 'MESA_CONTROL'
                      || request.auth.uid == uid);

      // Escritura: solo el propio empleado, solo imágenes JPEG/PNG, máx 10 MB
      allow write: if cuentaActiva()
                   && esRolConocido()
                   && request.auth.uid == uid
                   && request.resource.contentType.matches('image/(jpeg|png)')
                   && request.resource.size <= 10 * 1024 * 1024;

      allow delete: if cuentaActiva()
                    && (esAdminOSuperior() || request.auth.uid == uid);
    }

    // ── manuales/{docId}/{archivo} ────────────────────────────────────────────
    // Imágenes adjuntas a manuales y políticas operativas.
    match /manuales/{docId}/{archivo} {
      // Lectura: todos los usuarios autenticados y activos
      allow read: if cuentaActiva() && esRolConocido();
      // Escritura: solo admins, solo imágenes, máx 5 MB
      allow write: if cuentaActiva() && esAdminOSuperior()
                   && request.resource.contentType.matches('image/(jpeg|png|webp)')
                   && request.resource.size <= 5 * 1024 * 1024;
      // Eliminación: solo admins
      allow delete: if cuentaActiva() && esAdminOSuperior();
    }

    // ── fotos/productos/{docId}/{archivo} ────────────────────────────────────
    // Fotos del catálogo de productos subidas desde el panel web.
    match /fotos/productos/{docId}/{archivo} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.resource.contentType.matches('image/(jpeg|png|webp)')
                    && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // ── blacklist/{docId}/adjuntos/{archivo} ─────────────────────────────────
    // Adjuntos del expediente: contratos, pagarés, evidencias fotográficas
    match /blacklist/{docId}/adjuntos/{archivo} {
      // Lectura: cualquier rol autenticado activo
      allow read: if cuentaActiva() && esRolConocido();
      // Escritura: solo admins, máx 20 MB, tipos permitidos
      allow write: if cuentaActiva() && esAdminOSuperior()
                   && request.resource.size <= 20 * 1024 * 1024
                   && request.resource.contentType.matches(
                        'image/(jpeg|png|webp)|application/pdf|application/vnd.openxmlformats-officedocument.(wordprocessingml.document|spreadsheetml.sheet)');
      allow delete: if cuentaActiva() && esAdminOSuperior();
    }

    // ── chat_adjuntos/{canal}/{archivo} ──────────────────────────────────────
    // Archivos e imágenes compartidos en el chat interno.
    match /chat_adjuntos/{canal}/{archivo} {
      // Lectura: cualquier usuario autenticado activo
      allow read: if cuentaActiva() && esRolConocido();
      // Escritura: cualquier rol conocido, máx 20 MB, tipos: imagen/pdf/office
      allow write: if cuentaActiva()
                   && esRolConocido()
                   && request.resource.size <= 20 * 1024 * 1024
                   && request.resource.contentType.matches(
                        'image/(jpeg|png|webp|gif)|application/pdf|'
                        + 'application/vnd.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet)');
      allow delete: if cuentaActiva() && esRolConocido();
    }

    // Bloqueo por defecto — cualquier ruta no listada queda denegada
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
